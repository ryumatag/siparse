#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR
# shellcheck source=common.sh
source "$(dirname -- "$0")/common.sh"
[[ $# -le 1 ]] || die "Usage: $(basename "$0") [version]"
require_clean

version="${1:-$("$release_dir/get-next-version")}"
validate_version "$version"
[[ "$version" != "$(current_version)" ]] || die 'version is already current'
if git show-ref --verify --quiet "refs/tags/$version"; then
  die "tag $version already exists"
fi

"$release_dir/update-version" "$version"
cargo test
cargo test --no-default-features
cargo test --manifest-path fuzz/Cargo.toml --lib
cargo publish --dry-run --allow-dirty

# The working tree was clean before the version bump, so stage just the two
# release files.
git add -- Cargo.toml fuzz/Cargo.lock
git commit -m "release: $version"
printf 'Merge the release commit into main, then run scripts/release/publish.\n'
